{
    "name": "laulamanapps/apple-passbook",
    "description": "Generate Apple Wallet (previously Passbook) compatible tickets from PHP",
    "keywords": [
        "apple",
        "passbook",
        "php",
        "wallet",
        "event ticket",
        "coupon",
        "boarding pass",
        "store card",
        "iOS",
        "iPhone",
        "iPod Touch",
        "pkpass"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Laurens Laman",
            "email": "laurens.laman@llaman.nl"
        }
    ],
    "autoload": {
        "psr-4": {
            "LauLamanApps\\ApplePassbook\\": ["src/"]
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LauLamanApps\\ApplePassbook\\Tests\\": ["tests/"]
        }
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-zip": "*",
        "ext-exif": "*",
        "ramsey/uuid": "^3 || ^4"
    },
    "suggest": {
        "laulamanapps/apple-passbook-bundle": "^2.0"
    },
    "config": {
        "bin-dir": "bin"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.0|^11.0"
    }
}
